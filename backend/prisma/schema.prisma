generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  name          String   @default("")
  passwordHash  String
  phoneNumber   String?  @unique
  phoneVerified Boolean  @default(false)
  email         String?  @unique
  emailVerified Boolean  @default(false)
  avatarUrl     String?
  bio           String   @default("")
  statusText    String   @default("Hey there! I am using HelloTo.")
  lastSeenAt    DateTime?
  lastLoginAt   DateTime?
  suspendedUntil DateTime?
  isBlocked     Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages        Message[]
  chatMembers     ChatMember[]
  directChatsA    DirectChat[]        @relation("DirectChatUserA")
  directChatsB    DirectChat[]        @relation("DirectChatUserB")
  contactsOwned   Contact[]           @relation("OwnerContacts")
  contactLinks    Contact[]           @relation("LinkedUserContacts")
  emailOtps       EmailOtp[]
  statuses        StatusItem[]
  outgoingCalls   CallLog[]           @relation("CallLogCaller")
  incomingCalls   CallLog[]           @relation("CallLogReceiver")
  sentRequests    ConnectionRequest[] @relation("ConnectionRequestFrom")
  receivedRequests ConnectionRequest[] @relation("ConnectionRequestTo")
  auditEvents     UserAuditEvent[]
  reportsFiled    ModerationReport[]  @relation("ReportReporter")
  reportsAgainst  ModerationReport[]  @relation("ReportTarget")
  adminNotices    AdminNotice[]
}

model Contact {
  id           String   @id @default(cuid())
  ownerId      String
  linkedUserId String?
  name         String
  phoneNumber  String?
  email        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner      User  @relation("OwnerContacts", fields: [ownerId], references: [id])
  linkedUser User? @relation("LinkedUserContacts", fields: [linkedUserId], references: [id])

  @@index([ownerId, name])
}

model EmailOtp {
  id         String   @id @default(cuid())
  userId     String?
  email      String
  codeHash   String
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([email, purpose, expiresAt])
}

model PhoneOtp {
  id         String   @id @default(cuid())
  userId     String?
  phoneNumber String
  codeHash   String
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([phoneNumber, purpose, expiresAt])
}

model Chat {
  id        String       @id @default(cuid())
  title     String?
  avatarUrl String?
  isGroup   Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  direct   DirectChat?
  members  ChatMember[]
  messages Message[]
  statuses StatusItem[]
  calls    CallLog[]
}

model DirectChat {
  id      String @id @default(cuid())
  chatId  String @unique
  userAId String
  userBId String

  chat  Chat @relation(fields: [chatId], references: [id])
  userA User @relation("DirectChatUserA", fields: [userAId], references: [id])
  userB User @relation("DirectChatUserB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
  @@index([userBId, userAId])
}

model ChatMember {
  id         String   @id @default(cuid())
  chatId     String
  userId     String
  joinedAt   DateTime @default(now())
  lastReadAt DateTime?

  chat Chat @relation(fields: [chatId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([chatId, userId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  text      String   @default("")
  type      String   @default("text")
  mediaUrl  String?
  mediaName String?
  mediaMime String?
  createdAt DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id])
  sender User @relation(fields: [senderId], references: [id])

  @@index([chatId, createdAt])
}

model StatusItem {
  id        String   @id @default(cuid())
  userId    String
  chatId    String?
  text      String   @default("")
  mediaUrl  String?
  mediaType String?
  linkUrl   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  chat Chat? @relation(fields: [chatId], references: [id])

  @@index([userId, createdAt])
}

model ConnectionRequest {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  aliasName  String?
  phoneNumber String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  respondedAt DateTime?

  fromUser User @relation("ConnectionRequestFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("ConnectionRequestTo", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status, createdAt])
}

model CallLog {
  id              String   @id @default(cuid())
  chatId          String
  callerId        String
  receiverId      String
  mode            String
  status          String   @default("ringing")
  createdAt       DateTime @default(now())
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?

  chat     Chat @relation(fields: [chatId], references: [id])
  caller   User @relation("CallLogCaller", fields: [callerId], references: [id])
  receiver User @relation("CallLogReceiver", fields: [receiverId], references: [id])

  @@index([callerId, createdAt])
  @@index([receiverId, createdAt])
}

model UserAuditEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  detail    String
  actorType String   @default("system")
  actorId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

model ModerationReport {
  id             String   @id @default(cuid())
  reporterUserId String?
  targetUserId   String
  reason         String
  detail         String?
  status         String   @default("open")
  actionNote     String?
  createdAt      DateTime @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?

  reporterUser User? @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  targetUser   User  @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, status, createdAt])
  @@index([reporterUserId, createdAt])
}

model AdminNotice {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  sentBy    String
  createdAt DateTime @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
